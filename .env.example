# Copy to `.env` for local development. Never commit the real file — `.gitignore` blocks it.

# Base URL of the deployed leaderboard API, with no trailing slash.
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/prod
#
# Leave it empty to run without a backend. The game still works, your best run is kept in
# localStorage, and the leaderboard panel says it is offline. That is a supported state,
# not a broken one.
VITE_API_URL=
